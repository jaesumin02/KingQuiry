# KingQuiry Nginx Server Configuration Example
# Place in /etc/nginx/sites-available/kingquiry and symlink to sites-enabled/

server {
    listen 80;
    server_name kingquiry.local your-domain.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name kingquiry.local your-domain.com;

    root /var/www/kingquiry;
    index index.php index.html;

    # SSL Certificates (Configure with your Certbot / Let's Encrypt certificates)
    # ssl_certificate /etc/letsencrypt/live/your-domain.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/your-domain.com/privkey.pem;

    # Security Headers
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(self)" always;

    # Max upload size matching PHP configuration (5MB property images)
    client_max_body_size 6M;

    # Block access to hidden files and directories (like .git, .env)
    location ~ /\. {
        deny all;
        return 404;
    }

    # Block direct HTTP access to internal PHP directories
    location ~ ^/(config|database|includes|scratch|tests|logs|vendor|node_modules)/ {
        deny all;
        return 404;
    }

    # Block access to sensitive file extensions
    location ~* \.(sql|log|ini|env|bak|old|md)$ {
        deny all;
        return 404;
    }

    # Prevent script execution in upload directory
    location ~* ^/assets/images/.*\.(php|phtml|phar|cgi|pl|py|sh)$ {
        deny all;
        return 404;
    }

    # Static Assets Caching
    location ~* \.(css|js|jpg|jpeg|png|gif|ico|webp|svg|woff|woff2|ttf|eot)$ {
        expires 30d;
        add_header Cache-Control "public, no-transform";
        try_files $uri =404;
    }

    # Standard PHP Request Routing
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # PHP-FPM FastCGI Handler
    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_pass unix:/run/php/php8.2-fpm.sock; # Adjust PHP-FPM socket path as needed
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_intercept_errors on;
    }
}
