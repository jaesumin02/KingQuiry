# KingQuiry Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# DO NOT commit .env containing production secrets to public version control.

# Application Environment: 'development', 'test', or 'production'
KINGQUIRY_ENV=development

# Session Cookie HTTPS Flag: set to 'true' in production with HTTPS enabled
KINGQUIRY_COOKIE_SECURE=false

# Cryptographic Rate-Limit Secret (minimum 32 characters required in production)
KINGQUIRY_RATE_LIMIT_SECRET=kingquiry-secret-rate-limit-token-key-32chars-min

# Database Connection Settings
KINGQUIRY_DB_HOST=localhost
KINGQUIRY_DB_PORT=3306
KINGQUIRY_DB_USER=root
KINGQUIRY_DB_PASSWORD=
KINGQUIRY_DB_NAME=kingquiry_db

# Outbound email: choose smtp (recommended) or mail (PHP mail transport)
KINGQUIRY_MAIL_TRANSPORT=smtp
KINGQUIRY_MAIL_FROM=
KINGQUIRY_MAIL_FROM_NAME=KingQuiry
# Example Gmail/Google Workspace SMTP settings; use the provider's app password.
KINGQUIRY_SMTP_HOST=smtp.gmail.com
KINGQUIRY_SMTP_PORT=587
KINGQUIRY_SMTP_ENCRYPTION=tls
KINGQUIRY_SMTP_USERNAME=
KINGQUIRY_SMTP_PASSWORD=
# Enable only after testing SMTP/PHP mail with an address you control.
KINGQUIRY_DEV_MAIL_ENABLED=false

# Semaphore SMS OTP for signup, recovery, and staff fallback (keep the real key in private .env)
KINGQUIRY_SEMAPHORE_API_KEY=
# Optional: must be an active sender name registered in Semaphore
KINGQUIRY_SEMAPHORE_SENDERNAME=
